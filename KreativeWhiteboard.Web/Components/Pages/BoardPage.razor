@inject IJSRuntime JS
@page "/board/{id:guid}"
@layout BoardLayout
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using KreativeWhiteboard.Web.Components.Pages.BoardComponents

<PageTitle>@(board?.Title ?? "Board") — Kreative</PageTitle>

@if (error is not null)
{
    <div class="flex items-center justify-center h-screen bg-gray-950">
        <p class="text-red-400">Error: @error</p>
    </div>
}
else if (board is null)
{
    <div class="flex items-center justify-center h-screen bg-gray-950">
        <p class="text-gray-500 text-sm">Cargando...</p>
    </div>
}
else
{
    <div class="flex h-screen bg-gray-950 overflow-hidden">

        <div class="flex flex-col flex-1 overflow-hidden">

            <!-- Canvas -->
            <div class="relative flex-1 overflow-auto canvas-bg"
                style="background-color: #0a0a0f; background-image: radial-gradient(circle, #1f2937 1px, transparent 1px); background-size: 28px 28px;"
                @ref="canvasRef"
                @onmousemove="HandleMouseMove">

                <!-- Toolbar superior flotante -->
                <div class="absolute top-4 left-1/2 -translate-x-1/2 flex items-center gap-3 bg-gray-900/90 backdrop-blur border border-gray-700/50 rounded-2xl px-5 py-2 shadow-2xl" style="z-index: 9999;">
                    <div class="flex items-center gap-2 flex-wrap">
                        @for (int i = 0; i < breadcrumb.Count; i++)
                        {
                            var item = breadcrumb[i];
                            var isLast = i == breadcrumb.Count - 1;

                            @if (isLast)
                            {
                                @if (editandoTituloBoard && board?.ParentCardId == null)
                                {
                                    <input class="bg-transparent text-white font-semibold text-sm outline-none border-b border-indigo-500"
                                        @bind="tituloBoard"
                                        @onblur="GuardarTituloBoard"
                                        autofocus />
                                }
                                else
                                {
                                    <span class="text-white font-semibold text-sm @(board?.ParentCardId == null ? "cursor-text" : "")"
                                        @onclick="() => { if (board?.ParentCardId == null) editandoTituloBoard = true; }">
                                        @item.Title
                                    </span>
                                }
                            }
                            else
                            {
                                <a href="/board/@item.Id"
                                class="text-gray-400 hover:text-white transition-colors text-sm">
                                    @item.Title
                                </a>
                                <span class="text-gray-700 text-sm">›</span>
                            }
                        }
                    </div>
                    <div class="flex items-center gap-2 text-gray-500 text-xs border-l border-gray-700 pl-3">
                        <i data-lucide="users" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">Solo tú</span>
                    </div>
                </div>

                <!-- Toolbar lateral flotante -->
                <div class="hidden md:flex absolute left-4 top-1/2 -translate-y-1/2" style="z-index: 9999;">
                    <BoardToolbar IsMobile="false" OnAddCard="AgregarCard" OnAddBoard="AgregarBoard" OnAddImage="AgregarImagen" OnAddChecklist="AgregarChecklist" OnAddLink="AgregarLink" OnAddCountdown="AgregarCountdown" OnAddConnector="ToggleModoConector" IsConnectorMode="modoConector"/>
                </div>

                <!-- SVG para conectores -->
                <svg id="connectors-svg" class="absolute inset-0 w-full h-full pointer-events-none" style="z-index: 1;">
                    <defs>
                        <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
                            <polygon points="0 0, 10 3.5, 0 7" fill="#6366f1" />
                        </marker>
                    </defs>
                </svg>

                @foreach (var card in cards.OrderBy(c => c.CreatedAt))
                {
                    @if (card.Type == CardType.Board)
                    {
                        <BoardCard Card="card"
                                    IsSelected="seleccionados.Contains(card.Id)"
                                    OnDelete="EliminarCard"
                                    OnMove="HandleCardMoved"
                                    OnNavigate="Navegar"
                                    OnSave="GuardarCard"
                                    OnContextMenu="HandleBoardContextMenu" />
                    }
                    else if (card.Type == CardType.Image)
                    {
                        <ImageCard Card="card"
                                    ModoConector="modoConector"
                                    OnConectorClick="HandleCardClickConector"
                                    IsSelected="seleccionados.Contains(card.Id)"
                                    OnDelete="EliminarCard"
                                    OnMove="HandleCardMoved"
                                    OnSave="GuardarCard" />
                    }
                    else if (card.Type == CardType.Checklist)
                    {
                        <ChecklistCard Card="card"
                                    ModoConector="modoConector"
                                    OnConectorClick="HandleCardClickConector"
                                    IsSelected="seleccionados.Contains(card.Id)"
                                    OnDelete="EliminarCard"
                                    OnMove="HandleCardMoved"
                                    OnSave="GuardarCard" />
                    }
                    else if (card.Type == CardType.Link)
                    {
                        <LinkCard Card="card"
                                    ModoConector="modoConector"
                                    OnConectorClick="HandleCardClickConector"
                                    IsSelected="seleccionados.Contains(card.Id)"
                                    OnDelete="EliminarCard"
                                    OnMove="HandleCardMoved"
                                    OnSave="GuardarCard" />
                    }
                    else if (card.Type == CardType.Countdown)
                    {
                        <CountdownCard Card="card"
                                    ModoConector="modoConector"
                                    OnConectorClick="HandleCardClickConector"
                                    IsSelected="seleccionados.Contains(card.Id)"
                                    OnDelete="EliminarCard"
                                    OnMove="HandleCardMoved"
                                    OnSave="GuardarCard" />
                    }
                    else
                    {
                        <CardItem Card="card"
                                    ModoConector="modoConector"
                                    OnConectorClick="HandleCardClickConector"
                                    IsEditing="cardEditandoId == card.Id"
                                    IsSelected="seleccionados.Contains(card.Id)"
                                    OnDelete="EliminarCard"
                                    OnSave="GuardarCard"
                                    OnEdit="(id) => { cardEditandoId = id; }"
                                    OnMove="HandleCardMoved" />
                    }
                }

                @if (mostrarMenuBoard)
                {
                    <div class="fixed board-context-menu bg-gray-800 border border-gray-700 rounded-lg shadow-xl py-1 min-w-36"
                        style="z-index: 9998; left: @(menuBoardX)px; top: @(menuBoardY)px;">
                        <button class="w-full flex items-center gap-2 px-3 py-2 text-sm text-gray-200 hover:bg-gray-700 transition-colors"
                                @onclick="AbrirModalBoard">
                            <span>✏️</span> Editar nombre
                        </button>
                        <button class="w-full flex items-center gap-2 px-3 py-2 text-sm text-gray-200 hover:bg-gray-700 transition-colors"
                                @onclick="() => { CerrarMenuBoard(); if (cardMenuActual?.LinkedBoardId != null) Navegar(cardMenuActual.LinkedBoardId.Value); }">
                            <span>→</span> Abrir board
                        </button>
                        <div class="border-t border-gray-700 my-1"></div>
                        <button class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-400 hover:bg-gray-700 transition-colors"
                                @onclick="() => { CerrarMenuBoard(); if (cardMenuActual != null) EliminarCard(cardMenuActual); }">
                            <span>🗑️</span> Eliminar
                        </button>
                    </div>
                }

                @if (mostrarModalBoard)
                {
                    <div class="fixed inset-0 flex items-center justify-center bg-black/60" style="z-index: 9999;" @onclick="CerrarModalBoard">
                        <div class="bg-gray-900 border border-gray-700 rounded-xl p-6 w-80 shadow-2xl" @onclick:stopPropagation="true">
                            <h3 class="text-white font-semibold mb-4">Editar nombre del board</h3>
                            <input class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm outline-none focus:border-indigo-500 mb-4"
                                @bind="tituloEditadoBoard"
                                @onkeydown="HandleKeyDownBoard" />
                            <div class="flex gap-2 justify-end">
                                <button class="px-4 py-2 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded-lg text-sm transition-colors"
                                        @onclick="CerrarModalBoard">
                                    Cancelar
                                </button>
                                <button class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-sm transition-colors"
                                        @onclick="GuardarTituloBoard2">
                                    Guardar
                                </button>
                            </div>
                        </div>
                    </div>
                }

            </div>

        </div>
    </div>
}

@code {

    private bool mostrarMenuBoard = false;
    private bool mostrarModalBoard = false;
    private double menuBoardX, menuBoardY;
    private Card? cardMenuActual;
    private string tituloEditadoBoard = "";

    private void HandleBoardContextMenu((Card card, double x, double y) args)
    {
        cardMenuActual = args.card;
        menuBoardX = args.x;
        menuBoardY = args.y;
        mostrarMenuBoard = true;
        mostrarModalBoard = false;
    }

    private void CerrarMenuBoard() => mostrarMenuBoard = false;

    private void AbrirModalBoard()
    {
        tituloEditadoBoard = cardMenuActual?.Title ?? "";
        mostrarMenuBoard = false;
        mostrarModalBoard = true;
        StateHasChanged();
    }

    private void CerrarModalBoard() => mostrarModalBoard = false;

    private async Task GuardarTituloBoard2()
    {
        if (cardMenuActual is null || string.IsNullOrWhiteSpace(tituloEditadoBoard)) return;
        cardMenuActual.Title = tituloEditadoBoard;
        mostrarModalBoard = false;
        await GuardarCard(cardMenuActual);
    }

    private async Task HandleKeyDownBoard(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await GuardarTituloBoard2();
        if (e.Key == "Escape") CerrarModalBoard();
    }

    private void Navegar(Guid id)
    {
        Nav.NavigateTo($"/board/{id}");
    }

    [Parameter] public Guid Id { get; set; }

    private static readonly Guid OwnerId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    private Board? board;
    private List<Card> cards = new();
    private List<BreadcrumbItem> breadcrumb = new();
    private string? error;
    private Guid? cardEditandoId;
    private int nextX = 80;
    private int nextY = 80;

    protected override async Task OnInitializedAsync()
    {
        await CargarBoard();
        tituloBoard = board?.Title ?? "";
    }

    protected override async Task OnParametersSetAsync()
    {
        await CargarBoard();
    }

    private async Task CargarBoard() 
    { 
        try 
        { 
            error = null; 
            board = null; 
            cards = new(); 
            breadcrumb = new(); 
            connections = new(); 

            var http = HttpClientFactory.CreateClient("KreativeApi"); 

            board = await http.GetFromJsonAsync<Board>($"api/boards/{Id}"); 
            var result = await http.GetFromJsonAsync<List<Card>>($"api/cards?boardId={Id}"); 
            var bc = await http.GetFromJsonAsync<List<BreadcrumbItem>>($"api/boards/{Id}/breadcrumb"); 
            var conns = await http.GetFromJsonAsync<List<Connection>>($"api/connections?boardId={Id}");

            if (result is not null) cards = result; 
            if (bc is not null) breadcrumb = bc; 
            if (conns is not null) connections = conns;

            if (cards.Any()) 
            { 
                nextX = (int)cards.Max(c => c.X) + 20; 
                nextY = (int)cards.Max(c => c.Y) + 20; 
            } 
        } 
        catch (Exception ex) 
        { 
            error = ex.Message; 
        } 

        tituloBoard = board?.Title ?? ""; 

        if (connections.Any())
        {
            var connData = connections.Select(c => new { 
                sourceCardId = c.SourceCardId.ToString(), 
                targetCardId = c.TargetCardId.ToString() 
            });
        }
    }

    private async Task AgregarCard()
    {
        var (x, y, z) = await GetNewCardPosition();
        var http = HttpClientFactory.CreateClient("KreativeApi");
        var card = new Card
        {
            BoardId = Id,
            Type = CardType.Note,
            Title = "Nueva nota",
            Content = "",
            X = x,
            Y = y,
            ZIndex = z
        };

        var response = await http.PostAsJsonAsync("api/cards", card);
        var creada = await response.Content.ReadFromJsonAsync<Card>();
        if (creada is not null)
        {
            cards.Add(creada);
            cardEditandoId = creada.Id;
            StateHasChanged();
        }
    }

    private async Task AgregarBoard()
    {
        var (x, y, z) = await GetNewCardPosition();
        var http = HttpClientFactory.CreateClient("KreativeApi");

        var nuevoBoard = new Board
        {
            Title = "Nuevo Board",
            OwnerId = OwnerId,
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow
        };

        var boardResponse = await http.PostAsJsonAsync("api/boards", nuevoBoard);
        var boardCreado = await boardResponse.Content.ReadFromJsonAsync<Board>();
        if (boardCreado is null) return;

        var card = new Card
        {
            BoardId = Id,
            Type = CardType.Board,
            Title = boardCreado.Title,
            LinkedBoardId = boardCreado.Id,
            Content = "",
            X = x,
            Y = y,
            ZIndex = z
        };

        var cardResponse = await http.PostAsJsonAsync("api/cards", card);
        var cardCreada = await cardResponse.Content.ReadFromJsonAsync<Card>();
        if (cardCreada is null) return;

        boardCreado.ParentCardId = cardCreada.Id;
        await http.PutAsJsonAsync($"api/boards/{boardCreado.Id}", boardCreado);

        cards.Add(cardCreada);
        StateHasChanged();
    }

    private async Task GuardarCard(Card card)
    {
        cardEditandoId = null;
        var http = HttpClientFactory.CreateClient("KreativeApi");
        await http.PutAsJsonAsync($"api/cards/{card.Id}", card);

        if (card.Type == CardType.Board && card.LinkedBoardId.HasValue)
        {
            var boardVinculado = await http.GetFromJsonAsync<Board>($"api/boards/{card.LinkedBoardId}");
            if (boardVinculado is not null)
            {
                boardVinculado.Title = card.Title;
                await http.PutAsJsonAsync($"api/boards/{boardVinculado.Id}", boardVinculado);
            }
        }
    }

    private async Task EliminarCard(Card card)
    {
        var http = HttpClientFactory.CreateClient("KreativeApi");
        await http.DeleteAsync($"api/cards/{card.Id}");
        cards.Remove(card);
        StateHasChanged();
    }

    private bool editandoTituloBoard = false;
    private string tituloBoard = "";

    private async Task GuardarTituloBoard()
    {
        editandoTituloBoard = false;
        if (string.IsNullOrWhiteSpace(tituloBoard) || board is null) return;
        board.Title = tituloBoard;
        var http = HttpClientFactory.CreateClient("KreativeApi");
        await http.PutAsJsonAsync($"api/boards/{board.Id}", board);
        await CargarBoard();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {   
        if (firstRender)
        {
            await JS.InvokeVoidAsync("preventContextMenu", DotNetObjectReference.Create(this));
            await JS.InvokeVoidAsync("initSelection", DotNetObjectReference.Create(this));
            await JS.InvokeVoidAsync("setBoardDotNet", DotNetObjectReference.Create(this));
            await JS.InvokeVoidAsync("initKeyboard", DotNetObjectReference.Create(this));
        }

        if (cards.Any())
            await JS.InvokeVoidAsync("setZCounter", cards.Max(c => c.ZIndex));

        await Task.Delay(150);
        await JS.InvokeVoidAsync("lucide.createIcons");

        if (connections.Any())
        {
            var connData = connections.Select(c => new { 
                sourceCardId = c.SourceCardId.ToString(), 
                targetCardId = c.TargetCardId.ToString() 
            });
            await JS.InvokeVoidAsync("drawConnectors", connData);
        }
    }

    [JSInvokable]
    public void CerrarMenuDesdeJS()
    {
        mostrarMenuBoard = false;
        StateHasChanged();
    }

    private async Task AgregarImagen()
    {
        var (x, y, z) = await GetNewCardPosition();
        var http = HttpClientFactory.CreateClient("KreativeApi");
        var card = new Card
        {
            BoardId = Id,
            Type = CardType.Image,
            Title = "Imagen",
            Content = "",
            X = x,
            Y = y,
            ZIndex = z
        };

        var response = await http.PostAsJsonAsync("api/cards", card);
        var creada = await response.Content.ReadFromJsonAsync<Card>();
        if (creada is not null)
        {
            cards.Add(creada);
            StateHasChanged();
        }
    }

    private async Task AgregarChecklist()
    {
        var (x, y, z) = await GetNewCardPosition();
        var http = HttpClientFactory.CreateClient("KreativeApi");
        var card = new Card
        {
            BoardId = Id,
            Type = CardType.Checklist,
            Title = "Lista",
            Content = "[]",
            X = x,
            Y = y,
            ZIndex = z
        };

        var response = await http.PostAsJsonAsync("api/cards", card);
        var creada = await response.Content.ReadFromJsonAsync<Card>();
        if (creada is not null)
        {
            cards.Add(creada);
            StateHasChanged();
        }
    }

    private async Task AgregarLink()
    {
        var (x, y, z) = await GetNewCardPosition();
        var http = HttpClientFactory.CreateClient("KreativeApi");
        var card = new Card
        {
            BoardId = Id,
            Type = CardType.Link,
            Title = "Link",
            Content = "",
            X = x,
            Y = y,
            ZIndex = z
        };

        var response = await http.PostAsJsonAsync("api/cards", card);
        var creada = await response.Content.ReadFromJsonAsync<Card>();
        if (creada is not null)
        {
            cards.Add(creada);
            StateHasChanged();
        }
    }


    private ElementReference canvasRef;

    private async Task<(int x, int y, int z)> GetNewCardPosition()
    {
        var maxZ = cards.Any() ? cards.Max(c => c.ZIndex) + 1 : 1;
        
        // Obtener dimensiones del canvas via JS
        var rect = await JS.InvokeAsync<BoundingRect>("getBoundingRect", canvasRef);
        var x = (int)(rect.Width / 2) - 100 + (new Random().Next(-30, 30));
        var y = (int)(rect.Height / 2) - 100 + (new Random().Next(-30, 30));
        
        return (x, y, maxZ);
    }

    private class BoundingRect
    {
        public double Width { get; set; }
        public double Height { get; set; }
        public double Left { get; set; }
        public double Top { get; set; }
        public double ScrollLeft { get; set; }
        public double ScrollTop { get; set; }
    }

    private async Task AgregarCountdown()
    {
        var (x, y, z) = await GetNewCardPosition();
        var http = HttpClientFactory.CreateClient("KreativeApi");
        var card = new Card
        {
            BoardId = Id,
            Type = CardType.Countdown,
            Title = "Countdown",
            Content = "",
            X = x,
            Y = y,
            ZIndex = z
        };

        var response = await http.PostAsJsonAsync("api/cards", card);
        var creada = await response.Content.ReadFromJsonAsync<Card>();
        if (creada is not null)
        {
            cards.Add(creada);
            StateHasChanged();
        }
    }   

    private HashSet<Guid> seleccionados = new();

    [JSInvokable]
    public async Task LimpiarSeleccion()
    {
        seleccionados.Clear();
        await JS.InvokeVoidAsync("setSelectedCards", Array.Empty<string>());
        StateHasChanged();
    }

    [JSInvokable]
    public async Task SetSeleccion(List<string> ids)
    {
        seleccionados = ids.Select(Guid.Parse).ToHashSet();
        await JS.InvokeVoidAsync("setSelectedCards", ids);
        StateHasChanged();
    }

    private async Task HandleCardMoved((Guid id, int x, int y, int zIndex) args)
    {
        var card = cards.FirstOrDefault(c => c.Id == args.id);
        if (card is null) return;

        var dx = args.x - (int)card.X;
        var dy = args.y - (int)card.Y;

        card.X = args.x;
        card.Y = args.y;
        card.ZIndex = args.zIndex;

        var http = HttpClientFactory.CreateClient("KreativeApi");
        await http.PutAsJsonAsync($"api/cards/{card.Id}", card);

        // Mover las demás cards seleccionadas
        if (seleccionados.Contains(card.Id) && seleccionados.Count > 1)
        {
            foreach (var selectedId in seleccionados.Where(id => id != card.Id))
            {
                var selectedCard = cards.FirstOrDefault(c => c.Id == selectedId);
                if (selectedCard is null) continue;
                selectedCard.X += dx;
                selectedCard.Y += dy;
                await http.PutAsJsonAsync($"api/cards/{selectedCard.Id}", selectedCard);
            }
        }
    }
    
    [JSInvokable]
    public async Task EliminarSeleccionados()
    {
        if (seleccionados.Count == 0) return;
        var http = HttpClientFactory.CreateClient("KreativeApi");
        foreach (var id in seleccionados.ToList())
        {
            var card = cards.FirstOrDefault(c => c.Id == id);
            if (card is null) continue;
            await http.DeleteAsync($"api/cards/{card.Id}");
            cards.Remove(card);
        }
        seleccionados.Clear();
        await JS.InvokeVoidAsync("setSelectedCards", Array.Empty<string>());
        StateHasChanged();
    }
    
    [JSInvokable]
    public async Task OnGroupCardMoved(string cardId, int x, int y, int zIndex)
    {
        var card = cards.FirstOrDefault(c => c.Id == Guid.Parse(cardId));
        if (card is null) return;
        card.X = x;
        card.Y = y;
        card.ZIndex = zIndex;
        var http = HttpClientFactory.CreateClient("KreativeApi");
        await http.PutAsJsonAsync($"api/cards/{card.Id}", card);
    }
    
    private List<Connection> connections = new();
    private Guid? conectandoDesde = null;
    private bool modoConector = false;
    private int mouseX = 0, mouseY = 0;

    private async Task ToggleModoConector()
    {
        modoConector = !modoConector;
        conectandoDesde = null;
        await JS.InvokeVoidAsync("removePreviewConnector");
    }

    private async Task HandleCardClickConector(Guid cardId)
    {
        if (!modoConector) return;

        if (conectandoDesde is null)
        {
            conectandoDesde = cardId;
            await JS.InvokeVoidAsync("removePreviewConnector");
            return;
        }

        if (conectandoDesde == cardId)
        {
            conectandoDesde = null;
            await JS.InvokeVoidAsync("removePreviewConnector");
            return;
        }

        // Crear la conexión
        var http = HttpClientFactory.CreateClient("KreativeApi");
        var conn = new Connection
        {
            BoardId = Id,
            SourceCardId = conectandoDesde.Value,
            TargetCardId = cardId
        };

        var response = await http.PostAsJsonAsync("api/connections", conn);
        var creada = await response.Content.ReadFromJsonAsync<Connection>();
        if (creada is not null)
        {
            connections.Add(creada);
            conectandoDesde = null;
            StateHasChanged();
            await JS.InvokeVoidAsync("removePreviewConnector");
        }

        var connData = connections.Select(c => new { 
            sourceCardId = c.SourceCardId.ToString(), 
            targetCardId = c.TargetCardId.ToString() 
        });
        await JS.InvokeVoidAsync("drawConnectors", connData);
    }

    private async Task HandleMouseMove(MouseEventArgs e)
    {
        if (modoConector && conectandoDesde is not null)
        {
            var rect = await JS.InvokeAsync<BoundingRect>("getBoundingRect", canvasRef);
            mouseX = (int)(e.ClientX - rect.Left + rect.ScrollLeft);
            mouseY = (int)(e.ClientY - rect.Top + rect.ScrollTop);
            await JS.InvokeVoidAsync("updatePreviewConnector", 
                conectandoDesde.Value.ToString(), mouseX, mouseY);
        }
    }
    
}