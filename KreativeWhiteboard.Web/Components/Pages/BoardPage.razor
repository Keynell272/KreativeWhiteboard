@inject IJSRuntime JS
@page "/board/{id:guid}"
@inject IHttpClientFactory HttpClientFactory
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>@(board?.Title ?? "Board") — Kreative</PageTitle>

@if (error is not null)
{
    <div class="flex items-center justify-center h-screen bg-gray-950">
        <p class="text-red-400">Error: @error</p>
    </div>
}
else if (board is null)
{
    <div class="flex items-center justify-center h-screen bg-gray-950">
        <p class="text-gray-500 text-sm">Cargando...</p>
    </div>
}
else
{
    <div class="flex h-screen bg-gray-950 overflow-hidden">

        <!-- Sidebar izquierdo de herramientas -->
        <div class="flex flex-col items-center gap-1 w-16 bg-gray-900 border-r border-gray-800 py-4 z-10">
            
            <!-- Logo / Home -->
            <a href="/" class="flex items-center justify-center w-10 h-10 rounded-lg hover:bg-gray-800 transition-colors mb-2" title="Mis Boards">
                <i data-lucide="layout-dashboard" class="w-5 h-5 text-gray-400"></i>
            </a>

            <div class="w-8 border-t border-gray-800 my-1"></div>

            <!-- Herramientas -->
            <button @onclick="AgregarCard"
                    class="flex flex-col items-center gap-1 w-12 py-2 rounded-lg hover:bg-gray-800 transition-colors group"
                    title="Agregar nota">
                <i data-lucide="sticky-note" class="w-5 h-5 text-gray-400 group-hover:text-white transition-colors"></i>
                <span class="text-gray-500 text-[10px] group-hover:text-gray-300 transition-colors">Nota</span>
            </button>

            <button class="flex flex-col items-center gap-1 w-12 py-2 rounded-lg hover:bg-gray-800 transition-colors group opacity-40 cursor-not-allowed"
                    title="Próximamente">
                <i data-lucide="image" class="w-5 h-5 text-gray-400"></i>
                <span class="text-gray-500 text-[10px]">Imagen</span>
            </button>

            <button class="flex flex-col items-center gap-1 w-12 py-2 rounded-lg hover:bg-gray-800 transition-colors group opacity-40 cursor-not-allowed"
                    title="Próximamente">
                <i data-lucide="check-square" class="w-5 h-5 text-gray-400"></i>
                <span class="text-gray-500 text-[10px]">Lista</span>
            </button>

            <button class="flex flex-col items-center gap-1 w-12 py-2 rounded-lg hover:bg-gray-800 transition-colors group opacity-40 cursor-not-allowed"
                    title="Próximamente">
                <i data-lucide="link" class="w-5 h-5 text-gray-400"></i>
                <span class="text-gray-500 text-[10px]">Link</span>
            </button>

            <button class="flex flex-col items-center gap-1 w-12 py-2 rounded-lg hover:bg-gray-800 transition-colors group opacity-40 cursor-not-allowed"
                    title="Próximamente">
                <i data-lucide="spline" class="w-5 h-5 text-gray-400"></i>
                <span class="text-gray-500 text-[10px]">Conector</span>
            </button>

        </div>

        <!-- Contenido principal -->
        <div class="flex flex-col flex-1 overflow-hidden">

            <!-- Toolbar superior -->
            <div class="flex items-center justify-between px-5 py-2.5 bg-gray-900 border-b border-gray-800">
                <div class="flex items-center gap-3">
                    <h1 class="text-white font-semibold text-sm">@board.Title</h1>
                </div>
                <div class="flex items-center gap-2 text-gray-500 text-xs">
                    <i data-lucide="users" class="w-4 h-4"></i>
                    <span>Solo tú</span>
                </div>
            </div>

            <!-- Canvas -->
            <div class="relative flex-1 overflow-auto"
                 style="background-color: #0a0a0f; background-image: radial-gradient(circle, #1f2937 1px, transparent 1px); background-size: 28px 28px;">

                @foreach (var card in cards)
                {
                    <div class="absolute rounded-xl shadow-xl group select-none"
                         style="left: @(card.X)px; top: @(card.Y)px; width: 240px; background: #111827; border: 1px solid #1f2937;"
                         @ref="cardRefs[card.Id]">

                        <!-- Header de la card -->
                        <div class="flex items-center justify-between px-3 pt-3 pb-1 cursor-grab">
                            <div class="flex items-center gap-1.5">
                                <i data-lucide="sticky-note" class="w-3.5 h-3.5 text-indigo-400"></i>
                                <span class="text-indigo-400 text-[10px] font-semibold uppercase tracking-widest">Nota</span>
                            </div>
                            <button class="opacity-0 group-hover:opacity-100 transition-opacity text-gray-600 hover:text-red-400"
                                    @onclick="() => EliminarCard(card)"
                                    @onclick:stopPropagation="true">
                                <i data-lucide="x" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>

                        <!-- Contenido -->
                        <div class="px-3 pb-3">
                            @if (cardEditandoId == card.Id)
                            {
                                <textarea class="w-full bg-transparent text-gray-200 text-sm resize-none outline-none min-h-24 leading-relaxed"
                                          @bind="card.Content"
                                          @onblur="() => GuardarCard(card)"
                                          autofocus>
                                </textarea>
                            }
                            else
                            {
                                <p class="text-gray-300 text-sm cursor-text min-h-24 whitespace-pre-wrap leading-relaxed"
                                   @onclick="() => cardEditandoId = card.Id">
                                    @(string.IsNullOrEmpty(card.Content) ? "Escribe algo..." : card.Content)
                                </p>
                            }
                        </div>

                    </div>
                }

            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Board? board;
    private List<Card> cards = new();
    private string? error;
    private Guid? cardEditandoId;
    private int nextX = 80;
    private int nextY = 80;
    private Dictionary<Guid, ElementReference> cardRefs = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("KreativeApi");
            board = await http.GetFromJsonAsync<Board>($"api/boards/{Id}");
            var result = await http.GetFromJsonAsync<List<Card>>($"api/cards?boardId={Id}");
            if (result is not null)
            {
                cards = result;
                if (cards.Any())
                {
                    nextX = (int)cards.Max(c => c.X) + 20;
                    nextY = (int)cards.Max(c => c.Y) + 20;
                }
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        foreach (var card in cards)
        {
            if (cardRefs.ContainsKey(card.Id))
            {
                await JS.InvokeVoidAsync("dragDrop.init",
                    DotNetObjectReference.Create(this),
                    card.Id,
                    cardRefs[card.Id]);
            }
        }
        await JS.InvokeVoidAsync("lucide.createIcons");
    }

    private async Task AgregarCard()
    {
        var http = HttpClientFactory.CreateClient("KreativeApi");
        var card = new Card
        {
            BoardId = Id,
            Type = CardType.Note,
            Title = "Nueva nota",
            Content = "",
            X = nextX,
            Y = nextY
        };

        var response = await http.PostAsJsonAsync("api/cards", card);
        var creada = await response.Content.ReadFromJsonAsync<Card>();
        if (creada is not null)
        {
            cards.Add(creada);
            nextX += 30;
            nextY += 30;
            cardEditandoId = creada.Id;
            StateHasChanged();
        }
    }

    private async Task GuardarCard(Card card)
    {
        cardEditandoId = null;
        var http = HttpClientFactory.CreateClient("KreativeApi");
        await http.PutAsJsonAsync($"api/cards/{card.Id}", card);
    }

    [JSInvokable]
    public async Task OnCardMoved(string cardId, int x, int y)
    {
        var card = cards.FirstOrDefault(c => c.Id == Guid.Parse(cardId));
        if (card is null) return;
        card.X = x;
        card.Y = y;
        var http = HttpClientFactory.CreateClient("KreativeApi");
        await http.PutAsJsonAsync($"api/cards/{card.Id}", card);
    }

    private async Task EliminarCard(Card card)
    {
        var http = HttpClientFactory.CreateClient("KreativeApi");
        await http.DeleteAsync($"api/cards/{card.Id}");
        cards.Remove(card);
        StateHasChanged();
    }
}