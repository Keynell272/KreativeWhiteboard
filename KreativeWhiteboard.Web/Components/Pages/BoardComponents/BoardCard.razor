@inject IJSRuntime JS

<div class="absolute rounded-xl shadow-xl group select-none"
     style="left: @(Card.X)px; top: @(Card.Y)px; width: @(Card.Width)px; height: @(Card.Height)px; z-index: @(Card.ZIndex); background: #111827; border: 1px solid @(IsSelected ? "#6366f1" : "#1f2937"); @(IsSelected ? "box-shadow: 0 0 0 2px #6366f1, 0 0 16px 2px rgba(99,102,241,0.4);" : "")"         
     data-board-card="true"
     id="card-@Card.Id"
     @ref="elementRef"
     @onclick="HandleClick"
     @oncontextmenu="HandleContextMenu"
     @oncontextmenu:preventDefault="true"
     @ontouchstart="HandleTouchStart"
     @ontouchend="HandleTouchEnd"
     @ontouchmove="HandleTouchMove">

    <div class="flex items-center justify-between px-3 pt-3 pb-1 cursor-grab">
        <div class="flex items-center gap-1.5">
            <i data-lucide="layout-dashboard" class="w-3.5 h-3.5 text-indigo-300"></i>
            <span class="text-indigo-300 text-[10px] font-semibold uppercase tracking-widest">Board</span>
        </div>
        <button class="opacity-0 group-hover:opacity-100 transition-opacity text-indigo-800 hover:text-red-400"
                @onclick="() => OnDelete.InvokeAsync(Card)"
                @onclick:stopPropagation="true">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
        </button>
    </div>

    <div class="px-3 pb-4 pt-1" @onmousedown:stopPropagation="true">
        <p class="text-white font-medium text-sm">@Card.Title</p>
    </div>

</div>

@code {
    [Parameter] public Card Card { get; set; } = null!;
    [Parameter] public EventCallback<Card> OnDelete { get; set; }
    [Parameter] public EventCallback<(Guid, int, int, int)> OnMove { get; set; }
    [Parameter] public EventCallback<Guid> OnNavigate { get; set; }
    [Parameter] public EventCallback<Card> OnSave { get; set; }
    [Parameter] public EventCallback<(Card, double, double)> OnContextMenu { get; set; }
    [Parameter] public bool IsSelected { get; set; }

    private ElementReference elementRef;
    private bool dragInitialized = false;
    private bool isDragging = false;
    private bool justFinishedDragging = false;

    private double touchStartX, touchStartY;
    private bool longPressTriggered = false;
    private System.Threading.Timer? longPressTimer;
    private bool justFinishedResizing = false;

    private async Task HandleClick(MouseEventArgs e)
    {
        if (isDragging || justFinishedDragging || justFinishedResizing) return;
        await OnNavigate.InvokeAsync(Card.LinkedBoardId ?? Guid.Empty);
    }

    private void HandleContextMenu(MouseEventArgs e)
    {
        OnContextMenu.InvokeAsync((Card, e.ClientX, e.ClientY));
    }

    private void HandleTouchStart(TouchEventArgs e)
    {
        longPressTriggered = false;
        isDragging = false;
        if (e.Touches.Length > 0)
        {
            touchStartX = e.Touches[0].ClientX;
            touchStartY = e.Touches[0].ClientY;
        }
        longPressTimer = new System.Threading.Timer(_ =>
        {
            if (!isDragging)
            {
                longPressTriggered = true;
                InvokeAsync(() => OnContextMenu.InvokeAsync((Card, touchStartX, touchStartY)));
            }
        }, null, 600, System.Threading.Timeout.Infinite);
    }

    private void HandleTouchEnd(TouchEventArgs e)
    {
        longPressTimer?.Dispose();
        longPressTriggered = false;
    }

    private void HandleTouchMove(TouchEventArgs e)
    {
        isDragging = true;
        longPressTimer?.Dispose();
    }

    [JSInvokable]
    public void SetDragging(bool dragging)
    {
        isDragging = dragging;
        if (!dragging)
        {
            justFinishedDragging = true;
            Task.Delay(200).ContinueWith(_ => justFinishedDragging = false);
        }
    }

    [JSInvokable]
    public async Task OnCardMoved(string cardId, int x, int y, int zIndex)
    {
        Card.X = x;
        Card.Y = y;
        Card.ZIndex = zIndex;
        await OnMove.InvokeAsync((Guid.Parse(cardId), x, y, zIndex));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!dragInitialized)
        {
            dragInitialized = true;
            await JS.InvokeVoidAsync("dragDrop.init",
                DotNetObjectReference.Create(this),
                Card.Id,
                elementRef);
            await JS.InvokeVoidAsync("lucide.createIcons");
            await JS.InvokeVoidAsync("resizeCard",
                DotNetObjectReference.Create(this),
                Card.Id,
                elementRef);
        }
    }

    [JSInvokable]
    public async Task OnCardResized(string cardId, int width, int height)
    {
        Card.Width = width;
        Card.Height = height;
        await OnSave.InvokeAsync(Card);
    }

    [JSInvokable]
    public void SetResizing(bool resizing)
    {
        if (!resizing)
        {
            justFinishedResizing = true;
            Task.Delay(200).ContinueWith(_ => justFinishedResizing = false);
        }
    }
}