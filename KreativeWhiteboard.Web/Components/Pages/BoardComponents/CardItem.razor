@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory

<div class="absolute rounded-xl shadow-xl group select-none overflow-hidden"
     style="left: @(Card.X)px; top: @(Card.Y)px; width: @(Card.Width)px; height: @(Card.Height)px; z-index: @(Card.ZIndex); background: #111827; border: 1px solid #1f2937;"
     @ref="elementRef">

    <!-- Header -->
    <div class="flex items-center justify-between px-3 pt-3 pb-1 cursor-grab">
        <div class="flex items-center gap-1.5">
            <i data-lucide="sticky-note" class="w-3.5 h-3.5 text-indigo-400"></i>
            <span class="text-indigo-400 text-[10px] font-semibold uppercase tracking-widest">Nota</span>
        </div>
        <button class="opacity-0 group-hover:opacity-100 transition-opacity text-gray-600 hover:text-red-400"
                @onclick="() => OnDelete.InvokeAsync(Card)"
                @onclick:stopPropagation="true">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
        </button>
    </div>

    <!-- Contenido -->
    <div class="px-3 pb-3">
        @if (IsEditing)
        {
            <textarea class="w-full bg-transparent text-gray-200 text-sm resize-none outline-none min-h-24 leading-relaxed"
                    value="@Card.Content"
                    @onblur="() => OnSave.InvokeAsync(Card)"
                    @oninput="(e) => { Card.Content = e.Value?.ToString() ?? string.Empty; _ = GuardarDebounced(); }"
                    autofocus>
            </textarea>
        }
        else
        {
            <p class="text-gray-300 text-sm cursor-text whitespace-pre-wrap leading-relaxed break-words overflow-auto h-full"
                @onclick="() => OnEdit.InvokeAsync(Card.Id)">
                @(string.IsNullOrEmpty(Card.Content) ? "Escribe algo..." : Card.Content)
            </p>
        }
    </div>
</div>

@code {
    [Parameter] public Card Card { get; set; } = null!;
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public EventCallback<Card> OnDelete { get; set; }
    [Parameter] public EventCallback<Card> OnSave { get; set; }
    [Parameter] public EventCallback<Guid> OnEdit { get; set; }
    [Parameter] public EventCallback<(Guid, int, int, int)> OnMove { get; set; }
    
    private ElementReference elementRef;
    private bool dragInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!dragInitialized)
        {
            dragInitialized = true;
            await JS.InvokeVoidAsync("dragDrop.init",
                DotNetObjectReference.Create(this),
                Card.Id,
                elementRef);
            await JS.InvokeVoidAsync("lucide.createIcons");
            await JS.InvokeVoidAsync("resizeCard",
                DotNetObjectReference.Create(this),
                Card.Id,
                elementRef);
        }
    }

    [JSInvokable]
    public async Task OnCardMoved(string cardId, int x, int y, int zIndex)
    {
        Card.X = x;
        Card.Y = y;
        Card.ZIndex = zIndex;
        await OnMove.InvokeAsync((Guid.Parse(cardId), x, y, zIndex));
    }

    [JSInvokable]
    public void SetDragging(bool dragging) { }

    [JSInvokable]
    public async Task OnCardResized(string cardId, int width, int height)
    {
        Card.Width = width;
        Card.Height = height;
        await OnSave.InvokeAsync(Card);
    }

    private System.Threading.Timer? debounceTimer;

    private Task GuardarDebounced()
    {
        debounceTimer?.Dispose();
        debounceTimer = new System.Threading.Timer(async _ =>
        {
            var http = HttpClientFactory.CreateClient("KreativeApi");
            await http.PutAsJsonAsync($"api/cards/{Card.Id}", Card);
        }, null, 800, System.Threading.Timeout.Infinite);
        return Task.CompletedTask;
    }
    
}