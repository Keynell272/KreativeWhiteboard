@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory

<div class="absolute rounded-xl shadow-xl group select-none"
     style="left: @(Card.X)px; top: @(Card.Y)px; width: 240px; background: #111827; border: 1px solid #1f2937;"
     @ref="elementRef">

    <!-- Header -->
    <div class="flex items-center justify-between px-3 pt-3 pb-1 cursor-grab">
        <div class="flex items-center gap-1.5">
            <i data-lucide="image" class="w-3.5 h-3.5 text-emerald-400"></i>
            <span class="text-emerald-400 text-[10px] font-semibold uppercase tracking-widest">Imagen</span>
        </div>
        <button class="opacity-0 group-hover:opacity-100 transition-opacity text-gray-600 hover:text-red-400"
                @onclick="() => OnDelete.InvokeAsync(Card)"
                @onclick:stopPropagation="true">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
        </button>
    </div>

    <!-- Contenido -->
    <div class="px-3 pb-3" @onmousedown:stopPropagation="true">
        @if (string.IsNullOrEmpty(Card.Content))
        {
            <div class="flex flex-col items-center justify-center h-32 border-2 border-dashed border-gray-700 rounded-lg cursor-pointer hover:border-emerald-500 transition-colors"
                @onclick="AbrirSelector">
                <i data-lucide="upload" class="w-6 h-6 text-gray-600 mb-1"></i>
                <p class="text-gray-500 text-xs">Click para subir imagen</p>
            </div>
        }
        else
        {
            <img src="@Card.Content" alt="imagen" class="w-full rounded-lg object-cover max-h-48" />
        }
    </div>
</div>

@code {
    [Parameter] public Card Card { get; set; } = null!;
    [Parameter] public EventCallback<Card> OnDelete { get; set; }
    [Parameter] public EventCallback<(Guid, int, int)> OnMove { get; set; }
    [Parameter] public EventCallback<Card> OnSave { get; set; }

    private ElementReference elementRef;
    private bool dragInitialized = false;
    private bool subiendo = false;
    private string inputId => $"img-input-{Card.Id}";

    private async Task ManejarArchivo(ChangeEventArgs e)
    {
        subiendo = true;
        StateHasChanged();

        await JS.InvokeVoidAsync("uploadImageFromInput", inputId, DotNetObjectReference.Create(this));
    }

    [JSInvokable]
    public async Task OnImageUploaded(string url)
    {
        Card.Content = url;
        subiendo = false;
        await OnSave.InvokeAsync(Card);
        StateHasChanged();
    }

    [JSInvokable]
    public void SetDragging(bool dragging) { }

    [JSInvokable]
    public async Task OnCardMoved(string cardId, int x, int y)
    {
        await OnMove.InvokeAsync((Guid.Parse(cardId), x, y));
    }

    private async Task LimpiarImagen()
    {
        Card.Content = "";
        await OnSave.InvokeAsync(Card);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("console.log", $"OnAfterRender called, dragInitialized={dragInitialized}, firstRender={firstRender}");
        if (!dragInitialized)
        {
            dragInitialized = true;
            await JS.InvokeVoidAsync("dragDrop.init",
                DotNetObjectReference.Create(this),
                Card.Id,
                elementRef);
            await JS.InvokeVoidAsync("lucide.createIcons");
            await JS.InvokeVoidAsync("createImageInput", inputId, DotNetObjectReference.Create(this));
        }
    }

    private async Task AbrirSelector()
    {
        await JS.InvokeVoidAsync("triggerImageInput", inputId);
    }
}