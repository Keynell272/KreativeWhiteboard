@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory

<div class="absolute rounded-xl shadow-xl group select-none overflow-hidden flex flex-col"
     style="left: @(Card.X)px; top: @(Card.Y)px; width: @(Card.Width)px; height: @(Card.Height)px; z-index: @(Card.ZIndex); background: #111827; border: 1px solid @(IsSelected ? "#6366f1" : "#1f2937"); @(IsSelected ? "box-shadow: 0 0 0 2px #6366f1, 0 0 16px 2px rgba(99,102,241,0.4);" : "")"
     id="card-@Card.Id"
     @ref="elementRef" >

    <!-- Header -->
    <div class="flex items-center justify-between px-3 py-2 cursor-grab flex-shrink-0">
        <div class="flex items-center gap-1.5">
            <i data-lucide="image" class="w-3.5 h-3.5 text-emerald-400"></i>
            <span class="text-emerald-400 text-[10px] font-semibold uppercase tracking-widest">Imagen</span>
        </div>
        <button class="opacity-0 group-hover:opacity-100 transition-opacity text-gray-600 hover:text-red-400"
                @onclick="() => OnDelete.InvokeAsync(Card)"
                @onclick:stopPropagation="true">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
        </button>
    </div>

    <!-- Imagen -->
    <div class="flex-1 overflow-hidden" @onmousedown:stopPropagation="true">
        @if (string.IsNullOrEmpty(Card.Content))
        {
            <div class="flex flex-col items-center justify-center h-full border-2 border-dashed border-gray-700 mx-3 mb-3 rounded-lg cursor-pointer hover:border-emerald-500 transition-colors"
                @onclick="() => { if (!isDragging && !justFinishedDragging) AbrirSelector(); }">
                <i data-lucide="upload" class="w-6 h-6 text-gray-600 mb-1"></i>
                <p class="text-gray-500 text-xs">Click para subir imagen</p>
            </div>
        }
        else
        {
            <div class="w-full h-full"
                 style="background-image: url('@Card.Content'); background-size: cover; background-position: center; background-repeat: no-repeat;">
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Card Card { get; set; } = null!;
    [Parameter] public EventCallback<Card> OnDelete { get; set; }
    [Parameter] public EventCallback<(Guid, int, int, int)> OnMove { get; set; }
    [Parameter] public EventCallback<Card> OnSave { get; set; }
    [Parameter] public bool IsSelected { get; set; }

    private ElementReference elementRef;
    private bool dragInitialized = false;
    private string inputId => $"img-input-{Card.Id}";
    private bool isDragging = false;
    private bool justFinishedDragging = false;

    [JSInvokable]
    public async Task OnImageUploaded(string url)
    {
        Card.Content = url;
        await OnSave.InvokeAsync(Card);
        StateHasChanged();
    }

    [JSInvokable]
    public void SetDragging(bool dragging)
    {
        isDragging = dragging;
        if (!dragging)
        {
            justFinishedDragging = true;
            Task.Delay(200).ContinueWith(_ => justFinishedDragging = false);
        }
    }

    [JSInvokable]
    public async Task OnCardMoved(string cardId, int x, int y, int zIndex)
    {
        Card.X = x;
        Card.Y = y;
        Card.ZIndex = zIndex;
        await OnMove.InvokeAsync((Guid.Parse(cardId), x, y, zIndex));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!dragInitialized)
        {
            dragInitialized = true;
            await JS.InvokeVoidAsync("dragDrop.init",
                DotNetObjectReference.Create(this),
                Card.Id,
                elementRef);
            await JS.InvokeVoidAsync("lucide.createIcons");
            await JS.InvokeVoidAsync("createImageInput", inputId, DotNetObjectReference.Create(this));
            await JS.InvokeVoidAsync("resizeCard",
                DotNetObjectReference.Create(this),
                Card.Id,
                elementRef);
        }
    }

    private async Task AbrirSelector()
    {
        await JS.InvokeVoidAsync("triggerImageInput", inputId);
    }

    [JSInvokable]
    public async Task OnCardResized(string cardId, int width, int height)
    {
        Card.Width = width;
        Card.Height = height;
        await OnSave.InvokeAsync(Card);
    }

    [JSInvokable]
    public void SetResizing(bool resizing) { }

}