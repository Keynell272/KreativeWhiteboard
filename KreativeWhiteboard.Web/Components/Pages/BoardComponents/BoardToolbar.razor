<div class="@ContainerClass">

    <button @onclick="() => OnAddCard.InvokeAsync()" class="@ButtonClass group" title="Agregar nota">
        <i data-lucide="sticky-note" class="@IconClass text-gray-400 group-hover:text-white transition-colors"></i>
        <span class="@LabelClass">Nota</span>
    </button>

    <button @onclick="() => OnAddBoard.InvokeAsync()" class="@ButtonClass group" title="Agregar board">
        <i data-lucide="layout-dashboard" class="@IconClass text-gray-400 group-hover:text-white transition-colors"></i>
        <span class="@LabelClass">Board</span>
    </button>

    <button @onclick="() => OnAddImage.InvokeAsync()" class="@ButtonClass group" title="Agregar imagen">
        <i data-lucide="image" class="@IconClass text-gray-400 group-hover:text-white transition-colors"></i>
        <span class="@LabelClass">Imagen</span>
    </button>

    <button @onclick="() => OnAddChecklist.InvokeAsync()" class="@ButtonClass group" title="Agregar lista">
        <i data-lucide="check-square" class="@IconClass text-gray-400 group-hover:text-white transition-colors"></i>
        <span class="@LabelClass">Lista</span>
    </button>

    <button @onclick="() => OnAddLink.InvokeAsync()" class="@ButtonClass group" title="Agregar link">
        <i data-lucide="link" class="@IconClass text-gray-400 group-hover:text-white transition-colors"></i>
        <span class="@LabelClass">Link</span>
    </button>

    <button @onclick="() => OnAddCountdown.InvokeAsync()" class="@ButtonClass group" title="Countdown">
        <i data-lucide="timer" class="@IconClass text-gray-400 group-hover:text-white transition-colors"></i>
        <span class="@LabelClass">Timer</span>
    </button>

    <button @onclick="() => OnAddConnector.InvokeAsync()" 
            class="@ButtonClass group @(IsConnectorMode ? "bg-indigo-900" : "")" 
            title="Modo conector">
        <i data-lucide="spline" class="@IconClass @(IsConnectorMode ? "text-indigo-400" : "text-gray-400") group-hover:text-white transition-colors"></i>
        <span class="@LabelClass">Conector</span>
    </button>

</div>

@code {
    [Parameter] public bool IsMobile { get; set; }
    [Parameter] public EventCallback OnAddCard { get; set; }
    [Parameter] public EventCallback OnAddBoard { get; set; }
    [Parameter] public EventCallback OnAddImage { get; set; }
    [Parameter] public EventCallback OnAddChecklist { get; set; }
    [Parameter] public EventCallback OnAddLink { get; set; }
    [Parameter] public EventCallback OnAddCountdown { get; set; }
    [Parameter] public EventCallback OnAddConnector { get; set; }
    [Parameter] public bool IsConnectorMode { get; set; }
    
    private string ContainerClass => IsMobile
        ? "flex flex-row items-center justify-around w-full h-16 bg-gray-900 border-t border-gray-800 px-2"
        : "flex flex-col items-center gap-2 bg-gray-900/90 backdrop-blur rounded-2xl border border-gray-700/50 shadow-2xl py-3 px-1";

    private string ButtonClass => IsMobile
        ? "flex flex-col items-center gap-0.5 px-3 py-1 rounded-lg hover:bg-gray-800 transition-colors"
        : "flex flex-col items-center gap-1 w-12 py-2 rounded-lg hover:bg-gray-800 transition-colors";

    private string IconClass => "w-5 h-5";
    private string LabelClass => "text-gray-500 text-[10px]";

    private string DividerClass => IsMobile
        ? "w-px h-8 bg-gray-800"
        : "w-8 border-t border-gray-800 my-1";
}